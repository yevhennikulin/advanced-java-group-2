+/*
+  EXERCISES & CATEGORIES STYLES
+  =============================
+*/
+
+.exercises-section {
+  background-color: #f4f4f4; /* Main body light background as per Figma root node */
+  color: #242424; /* Dark grey text */
+  padding-top: 40px;
+  padding-bottom: 40px;
+}
+
+@media screen and (min-width: 768px) {
+  .exercises-section {
+    padding-top: 80px;
+    padding-bottom: 80px;
+  }
+}
+
+.exercises-top-bar {
+  display: flex;
+  flex-direction: column;
+  gap: 20px;
+  margin-bottom: 32px;
+}
+
+@media screen and (min-width: 768px) {
+  .exercises-top-bar {
+    flex-direction: row;
+    justify-content: space-between;
+    align-items: center;
+    margin-bottom: 40px;
+  }
+}
+
+/* ------------------------------------------
+   Section Header
+   ------------------------------------------ */
+.exercises-title {
+  font-family: var(--font-family);
+  font-size: 32px;
+  font-weight: 400;
+  line-height: 1.12;
+  letter-spacing: -0.02em;
+  color: #242424;
+}
+
+@media screen and (min-width: 768px) {
+  .exercises-title {
+    font-size: 44px;
+    line-height: 1.09;
+  }
+}
+
+.exercises-title-divider {
+  color: rgba(36, 36, 36, 0.5);
+  margin-left: 4px;
+  margin-right: 4px;
+}
+
+.exercises-title-accent {
+  color: rgba(36, 36, 36, 0.5);
+  text-transform: capitalize;
+}
+
+/* ------------------------------------------
+   Controls: Search and Tabs
+   ------------------------------------------ */
+.exercises-controls {
+  display: flex;
+  flex-direction: column;
+  gap: 20px;
+}
+
+@media screen and (min-width: 768px) {
+  .exercises-controls {
+    flex-direction: row;
+    align-items: center;
+    gap: 32px;
+  }
+}
+
+/* Search input */
+.exercises-search-form {
+  position: relative;
+  width: 100%;
+  max-width: 335px;
+}
+
+@media screen and (min-width: 768px) {
+  .exercises-search-form {
+    width: 273px;
+  }
+}
+
+.exercises-search-input {
+  width: 100%;
+  height: 44px;
+  padding: 12px 40px 12px 14px;
+  background-color: transparent;
+  border: 1px solid rgba(36, 36, 36, 0.2);
+  border-radius: 30px;
+  color: #242424;
+  font-size: var(--font-size-sm);
+  line-height: 1.5;
+  outline: none;
+  transition: border-color var(--transition-base);
+}
+
+@media screen and (min-width: 768px) {
+  .exercises-search-input {
+    height: 48px;
+    font-size: var(--font-size-base);
+  }
+}
+
+.exercises-search-input:focus {
+  border-color: #242424;
+}
+
+.exercises-search-input::placeholder {
+  color: rgba(36, 36, 36, 0.5);
+}
+
+.exercises-search-btn {
+  position: absolute;
+  top: 50%;
+  right: 14px;
+  transform: translateY(-50%);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: none;
+  border: none;
+  padding: 0;
+  color: #242424;
+  cursor: pointer;
+  transition: color var(--transition-base);
+}
+
+.exercises-search-btn:hover,
+.exercises-search-btn:focus {
+  color: var(--color-accent);
+}
+
+/* Tabs list */
+.exercises-tabs .tabs-list {
+  display: flex;
+  align-items: center;
+  gap: 20px;
+}
+
+.tabs-btn {
+  position: relative;
+  background: none;
+  border: none;
+  padding: 0 0 6px 0;
+  color: rgba(36, 36, 36, 0.5);
+  font-size: var(--font-size-sm);
+  font-weight: 400;
+  line-height: 1.5;
+  cursor: pointer;
+  transition: color var(--transition-base);
+}
+
+@media screen and (min-width: 768px) {
+  .tabs-btn {
+    font-size: var(--font-size-base);
+  }
+}
+
+.tabs-btn:hover,
+.tabs-btn:focus {
+  color: #242424;
+}
+
+.tabs-btn.active {
+  color: #242424;
+  font-weight: 500;
+}
+
+.tabs-active-line {
+  display: none;
+  position: absolute;
+  bottom: 0;
+  left: 0;
+  width: 100%;
+  height: 4px;
+  background-color: #242424;
+  border-radius: 2px;
+}
+
+.tabs-btn.active .tabs-active-line {
+  display: block;
+}
+
+/* ------------------------------------------
+   Categories Grid
+   ------------------------------------------ */
+.categories-grid {
+  display: grid;
+  grid-template-columns: 1fr;
+  gap: 20px;
+}
+
+@media screen and (min-width: 768px) {
+  .categories-grid {
+    grid-template-columns: repeat(3, 1fr);
+    gap: 16px;
+  }
+}
+
+@media screen and (min-width: 1440px) {
+  .categories-grid {
+    gap: 32px 16px;
+  }
+}
+
+.category-card {
+  position: relative;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 100%;
+  height: 225px;
+  border-radius: 12px;
+  overflow: hidden;
+  cursor: pointer;
+  background-color: var(--color-primary); /* Fallback bg (#242424) */
+  transition: transform var(--transition-base), box-shadow var(--transition-base);
+}
+
+@media screen and (min-width: 1440px) {
+  .category-card {
+    height: 242px;
+  }
+}
+
+.category-card:hover,
+.category-card:focus {
+  transform: translateY(-4px);
+  box-shadow: 0 8px 24px rgba(17, 17, 17, 0.15);
+}
+
+.category-card-img {
+  position: absolute;
+  top: 0;
+  left: 0;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  transition: transform var(--transition-base);
+}
+
+.category-card:hover .category-card-img,
+.category-card:focus .category-card-img {
+  transform: scale(1.05);
+}
+
+.category-card-overlay {
+  position: absolute;
+  top: 0;
+  left: 0;
+  width: 100%;
+  height: 100%;
+  background: rgba(17, 17, 17, 0.5); /* Figma overlay style */
+  z-index: 1;
+}
+
+.category-card-content {
+  position: relative;
+  z-index: 2;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  text-align: center;
+  gap: 2px;
+  padding: 16px;
+}
+
+.category-card-name {
+  font-family: var(--font-family);
+  font-size: 20px;
+  font-weight: 400;
+  line-height: 1.2;
+  color: #f4f4f4; /* White text */
+  text-transform: capitalize;
+}
+
+@media screen and (min-width: 1440px) {
+  .category-card-name {
+    font-size: 24px;
+  }
+}
+
+.category-card-filter {
+  font-family: var(--font-family);
+  font-size: 12px;
+  font-weight: 400;
+  line-height: 1.5;
+  color: rgba(244, 244, 244, 0.5); /* Muted white subtitle */
+  text-transform: capitalize;
+}
+
+/* ------------------------------------------
+   Fallback Empty State
+   ------------------------------------------ */
+.exercises-fallback {
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  padding: 60px 16px;
+  text-align: center;
+}
+
+.fallback-text {
+  font-size: var(--font-size-base);
+  line-height: 1.5;
+  color: rgba(36, 36, 36, 0.6);
+  max-width: 400px;
+}
+
+/* ------------------------------------------
+   Pagination Styling
+   ------------------------------------------ */
+.pagination-container {
+  display: flex;
+  justify-content: center;
+  margin-top: 32px;
+}
+
+@media screen and (min-width: 768px) {
+  .pagination-container {
+    margin-top: 40px;
+  }
+}
+
+.pagination-list {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.pagination-btn {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  min-width: 32px;
+  height: 32px;
+  background: none;
+  border: none;
+  padding: 0 4px;
+  border-radius: 50%;
+  color: rgba(36, 36, 36, 0.5);
+  font-size: var(--font-size-base);
+  font-weight: 400;
+  cursor: pointer;
+  transition: color var(--transition-base), background-color var(--transition-base);
+}
+
+.pagination-btn:hover,
+.pagination-btn:focus {
+  color: #242424;
+}
+
+.pagination-btn.active {
+  background-color: #242424;
+  color: #f4f4f4;
+}
+
+/* Spinner Loader */
+.loader {
+  width: 48px;
+  height: 48px;
+  border: 5px solid rgba(36, 36, 36, 0.2);
+  border-bottom-color: #242424;
+  border-radius: 50%;
+  display: inline-block;
+  box-sizing: border-box;
+  animation: rotation 1s linear infinite;
+  margin: 40px auto;
+  grid-column: 1 / -1; /* Center loader across grid columns */
+  justify-self: center;
+}
+
+@keyframes rotation {
+  0% {
+    transform: rotate(0deg);
+  }
+  100% {
+    transform: rotate(360deg);
+  }
+}
+
